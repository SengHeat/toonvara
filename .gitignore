
# ============================================================
# Toonvara - Git Ignore
# Rust + Bevy + egui + JSON + FFmpeg
# ============================================================

# ------------------------------------------------------------
# 1. Rust / Cargo
# ------------------------------------------------------------

/target/

# Keep Cargo.lock committed for reproducible application builds.
# Do NOT ignore Cargo.lock.

**/*.rs.bk
*.pdb

# ------------------------------------------------------------
# 2. IDE / Editors
# ------------------------------------------------------------

.idea/
*.iml

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

*.swp
*.swo
*~
.project
.classpath
.settings/

# ------------------------------------------------------------
# 3. Operating System
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# 4. Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ------------------------------------------------------------
# 5. Bevy / Graphics Cache
# ------------------------------------------------------------

/.bevy/
/.cache/
/shader_cache/
/pipeline_cache/

# ------------------------------------------------------------
# 6. Generated Videos / Render Outputs
# ------------------------------------------------------------

/outputs/*
!/outputs/.gitkeep

/renders/*
!/renders/.gitkeep

/frames/*
!/frames/.gitkeep

/previews/*
!/previews/.gitkeep

# Intermediate rendering files
*.tmp
*.temp
*.part

# ------------------------------------------------------------
# 7. FFmpeg Temporary Files
# ------------------------------------------------------------

/render_cache/
/encoding_cache/
/audio_cache/

# ------------------------------------------------------------
# 8. Temporary Files
# ------------------------------------------------------------

/tmp/
/temp/
/.cache-test/

*.log
/logs/*

# ------------------------------------------------------------
# 9. Python / Optional Blender Tools
# ------------------------------------------------------------

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Blender backup files (keep original .blend assets)
*.blend1
*.blend2
*.blend@
*.blend@*

# ------------------------------------------------------------
# 10. Testing / Coverage
# ------------------------------------------------------------

/coverage/
/test-results/
/test-output/

*.profraw
*.profdata
tarpaulin-report.html
lcov.info
*.gcda
*.gcno

# ------------------------------------------------------------
# 11. Build / Distribution
# ------------------------------------------------------------

/build/
/dist/
/packages/output/

# ------------------------------------------------------------
# 12. Local Project Settings
# ------------------------------------------------------------

/config/local.json
/config/local.toml
/config/user.json

# ------------------------------------------------------------
# 13. Local Backups
# ------------------------------------------------------------

/backups/
*.bak
*.backup

# ------------------------------------------------------------
# IMPORTANT: TRACK THESE FILES
# ------------------------------------------------------------

# Cargo.toml
# Cargo.lock
# rust-toolchain.toml
# README.md
# schemas/*.json
# examples/*.json
# assets/**/*.glb
# assets/**/*.gltf
# assets/**/*.png
# assets/**/*.blend
# assets/**/*.wav
# assets/**/*.ogg
# assets/**/*.ttf
# assets/**/*.otf
#
# Keep source assets, character models, fonts, animation
# clips, shader source, and sample JSON files in Git.
#
# Large assets can use Git LFS.
# ============================================================
